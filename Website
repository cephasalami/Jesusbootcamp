< !DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>The Jesus Boot Camp — From Believer to Disciple</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"><style>

/*─────────────────────────────────────────
  RESET & TOKENS
─────────────────────────────────────────*/
*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

:root {
    --cream: #F5F0E8;
    --cream2: #EDE7D9;
    --navy: #0A1F44;
    --navy2: #0D2550;
    --gold: #C9A84C;
    --gold2: #E0BF6F;
    --grey: #6B6B6B;
    --white: #FFFFFF;
    --card-border: #E0D8C8;
    --f-display: 'Playfair Display', Georgia, serif;
    --f-body: 'Inter', system-ui, sans-serif;
}

body {
    font-family: var(--f-body);
    background: var(--cream);
    color: var(--navy);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

img {
    display: block;
    max-width: 100%;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    cursor: pointer;
    font-family: var(--f-body);
}

/*─────────────────────────────────────────
  UTILITIES
─────────────────────────────────────────*/
.label {
    font-family: var(--f-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
}

.section-tag {
    display: inline-block;
    background: rgba(201, 168, 76, 0.12);
    color: var(--gold);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 20px;
    border: 1px solid rgba(201, 168, 76, 0.3);
    margin-bottom: 1.2rem;
}

.btn-gold {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--gold);
    color: var(--navy);
    font-family: var(--f-body);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: 8px;
    border: none;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(201, 168, 76, 0.3);
}

.btn-gold:hover {
    background: var(--gold2);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(201, 168, 76, 0.35);
}

.btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: var(--navy);
    font-family: var(--f-body);
    font-size: 15px;
    font-weight: 600;
    padding: 13px 27px;
    border-radius: 8px;
    border: 1.5px solid var(--navy);
    transition: all 0.2s;
    cursor: pointer;
    text-decoration: none;
}

.btn-outline:hover {
    background: var(--navy);
    color: var(--cream);
}

.btn-outline-cream {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: var(--cream);
    font-family: var(--f-body);
    font-size: 15px;
    font-weight: 600;
    padding: 13px 27px;
    border-radius: 8px;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    transition: all 0.2s;
    cursor: pointer;
    text-decoration: none;
}

.btn-outline-cream:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.6);
}

/*─────────────────────────────────────────
  1. NAVBAR
─────────────────────────────────────────*/
#navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 500;
    background: var(--cream);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s;
}

#navbar.scrolled {
    border-color: var(--card-border);
    box-shadow: 0 1px 24px rgba(10, 31, 68, 0.06);
}

.nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
    height: 68px;
}

.nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
}

.nav-logo-icon {
    width: 36px;
    height: 36px;
    background: var(--navy);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
}

.nav-logo-text {
    font-family: var(--f-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: 0.02em;
    line-height: 1.2;
    max-width: 180px;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
}

.nav-links a {
    display: block;
    padding: 0 1.1rem;
    font-size: 14px;
    font-weight: 500;
    color: var(--grey);
    transition: color 0.18s;
    white-space: nowrap;
}

.nav-links a:hover {
    color: var(--navy);
}

.nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
}

.nav-cta {
    background: var(--gold);
    color: var(--navy);
    font-size: 13.5px;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 7px;
    border: none;
    transition: background 0.2s;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
}

.nav-cta:hover {
    background: var(--gold2);
}

.hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 4px;
}

.hamburger span {
    width: 22px;
    height: 1.5px;
    background: var(--navy);
    display: block;
    transition: all 0.3s;
}

/*─────────────────────────────────────────
  2. HERO
─────────────────────────────────────────*/
#hero {
    min-height: 100vh;
    padding: 120px 2rem 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    position: relative;
    overflow: hidden;
    background: var(--cream);
}

.hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 4rem;
    align-items: flex-start;
}

.hero-left {
    padding-top: 1rem;
}

.hero-label-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(201, 168, 76, 0.1);
    border: 1px solid rgba(201, 168, 76, 0.35);
    border-radius: 20px;
    padding: 6px 16px 6px 10px;
    margin-bottom: 2rem;
}

.hero-label-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    animation: pulse 2s infinite;
}

@keyframes pulse {

    0%,
    100% {
        opacity: 1;
        transform: scale(1)
    }

    50% {
        opacity: 0.5;
        transform: scale(0.8)
    }
}

.hero-label-text {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
}

.hero-headline {
    font-family: var(--f-display);
    font-size: clamp(3.5rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    color: var(--navy);
    margin-bottom: 1.6rem;
    letter-spacing: -0.02em;
}

.hero-headline em {
    font-style: italic;
    color: var(--gold);
}

.hero-sub {
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--grey);
    line-height: 1.75;
    max-width: 500px;
    margin-bottom: 2.5rem;
}

.hero-sub strong {
    color: var(--navy);
    font-weight: 600;
}

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}

.hero-trust {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding-top: 2rem;
    border-top: 1px solid var(--card-border);
}

.hero-trust-avatars {
    display: flex;
}

.hero-trust-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--cream);
    margin-left: -8px;
    font-size: 11px;
    font-weight: 700;
    color: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--navy);
    flex-shrink: 0;
}

.hero-trust-avatar:first-child {
    margin-left: 0;
}

.hero-trust-text {
    font-size: 13px;
    color: var(--grey);
    line-height: 1.4;
}

.hero-trust-text strong {
    color: var(--navy);
    font-weight: 600;
}

/* Floating UI Mockup Card */
.hero-card {
    background: var(--white);
    border-radius: 16px;
    border: 1px solid var(--card-border);
    box-shadow: 0 24px 80px rgba(10, 31, 68, 0.12), 0 4px 16px rgba(10, 31, 68, 0.06);
    overflow: hidden;
    margin-top: 2rem;
    animation: floatCard 4s ease-in-out infinite;
}

@keyframes floatCard {

    0%,
    100% {
        transform: translateY(0)
    }

    50% {
        transform: translateY(-8px)
    }
}

.card-topbar {
    background: var(--navy);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-topbar-dots {
    display: flex;
    gap: 6px;
}

.card-topbar-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
}

.card-topbar-title {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.card-body {
    padding: 20px;
}

.card-welcome {
    font-size: 12px;
    color: var(--grey);
    margin-bottom: 4px;
}

.card-welcome strong {
    color: var(--navy);
    font-weight: 600;
}

.card-lesson-title {
    font-family: var(--f-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    margin-bottom: 14px;
}

.card-thumb {
    width: 100%;
    height: 120px;
    background: linear-gradient(135deg, var(--navy) 0%, #1a3a7c 100%);
    border-radius: 8px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.card-thumb-cross {
    width: 40px;
    height: 40px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.card-thumb-cross::before,
.card-thumb-cross::after {
    content: '';
    position: absolute;
    background: rgba(201, 168, 76, 0.5);
}

.card-thumb-cross::before {
    width: 2px;
    height: 100%;
}

.card-thumb-cross::after {
    width: 100%;
    height: 2px;
}

.card-thumb-label {
    position: absolute;
    bottom: 8px;
    left: 10px;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 4px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.8);
    padding: 2px 8px;
    font-weight: 500;
}

.card-progress-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.card-progress-label span {
    font-size: 11px;
    color: var(--grey);
    font-weight: 500;
}

.card-progress-label strong {
    font-size: 11px;
    color: var(--gold);
    font-weight: 700;
}

.progress-bar-bg {
    height: 5px;
    background: #E8E0D0;
    border-radius: 3px;
    margin-bottom: 14px;
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    background: var(--gold);
    border-radius: 3px;
    width: 0%;
}

.card-locked {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(10, 31, 68, 0.04);
    border-radius: 8px;
    padding: 10px 12px;
    border: 1px solid var(--card-border);
}

.card-locked-icon {
    font-size: 16px;
}

.card-locked-text {
    font-size: 12px;
    color: var(--grey);
    font-weight: 500;
}

.card-locked-text strong {
    color: var(--navy);
}

.card-sessions-preview {
    margin-top: 12px;
}

.session-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 0;
    border-bottom: 1px solid #F0EAE0;
    font-size: 12px;
    color: var(--grey);
}

.session-row:last-child {
    border-bottom: none;
}

.session-num {
    font-weight: 700;
    color: var(--gold);
    min-width: 24px;
    font-size: 11px;
}

.session-icon {
    font-size: 14px;
}

/* Ticker */
.ticker-strip {
    background: var(--navy);
    padding: 14px 0;
    overflow: hidden;
    white-space: nowrap;
    margin-top: 5rem;
    flex-shrink: 0;
}

.ticker-inner {
    display: inline-flex;
    gap: 0;
    animation: ticker 30s linear infinite;
}

.ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0 2.5rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
}

.ticker-sep {
    color: rgba(201, 168, 76, 0.35);
    font-size: 16px;
}

@keyframes ticker {
    from {
        transform: translateX(0)
    }

    to {
        transform: translateX(-50%)
    }
}

/*─────────────────────────────────────────
  3. SOCIAL PROOF
─────────────────────────────────────────*/
#social-proof {
    background: var(--white);
    border-top: 1px solid var(--card-border);
    border-bottom: 1px solid var(--card-border);
    padding: 2.5rem 2rem;
}

.proof-inner {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
}

.proof-item {
    text-align: center;
    padding: 0 2rem;
    border-right: 1px solid var(--card-border);
}

.proof-item:last-child {
    border-right: none;
}

.proof-num {
    font-family: var(--f-display);
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--navy);
    line-height: 1;
}

.proof-label {
    font-size: 13px;
    color: var(--grey);
    margin-top: 4px;
    font-weight: 400;
}

.proof-sub {
    font-size: 11px;
    color: var(--gold);
    font-weight: 600;
    margin-top: 2px;
    letter-spacing: 0.05em;
}

/*─────────────────────────────────────────
  4. THE PROBLEM
─────────────────────────────────────────*/
#problem {
    padding: 8rem 2rem;
    background: var(--cream);
}

.problem-inner {
    max-width: 1200px;
    margin: 0 auto;
}

.problem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
    margin-bottom: 5rem;
}

.problem-pullquote {
    font-family: var(--f-display);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 700;
    font-style: italic;
    color: var(--navy);
    line-height: 1.3;
    position: relative;
    padding-left: 2rem;
}

.problem-pullquote::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--gold);
    border-radius: 2px;
}

.problem-body {
    font-size: 1.05rem;
    color: var(--grey);
    line-height: 1.8;
    font-weight: 400;
}

.problem-body p {
    margin-bottom: 1rem;
}

.problem-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
}

.pain-card {
    background: var(--white);
    border-radius: 12px;
    border: 1px solid var(--card-border);
    border-left: 4px solid var(--gold);
    padding: 1.5rem;
    transition: box-shadow 0.2s;
}

.pain-card:hover {
    box-shadow: 0 8px 30px rgba(10, 31, 68, 0.08);
}

.pain-icon {
    font-size: 1.5rem;
    margin-bottom: 0.8rem;
}

.pain-card p {
    font-size: 14px;
    color: var(--grey);
    line-height: 1.6;
    font-style: italic;
}

/*─────────────────────────────────────────
  5. SOLUTION (dark navy)
─────────────────────────────────────────*/
#solution {
    background: var(--navy);
    padding: 7rem 2rem;
}

.solution-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
}

.solution-headline {
    font-family: var(--f-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--cream);
    line-height: 1.25;
    margin-bottom: 1rem;
}

.solution-sub {
    font-size: 1rem;
    color: rgba(245, 240, 232, 0.6);
    margin-bottom: 4rem;
}

.solution-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 3.5rem;
}

.sol-card {
    background: var(--navy);
    padding: 2.5rem 1.8rem;
    text-align: center;
    transition: background 0.2s;
    position: relative;
}

.sol-card:hover {
    background: var(--navy2);
}

.sol-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 3px;
    background: var(--gold);
    border-radius: 0 0 3px 3px;
}

.sol-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
    display: block;
}

.sol-card h3 {
    font-family: var(--f-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.7rem;
}

.sol-card p {
    font-size: 13px;
    color: rgba(245, 240, 232, 0.55);
    line-height: 1.6;
}

/*─────────────────────────────────────────
  6. HOW IT WORKS
─────────────────────────────────────────*/
#how {
    padding: 8rem 2rem;
    background: var(--cream);
}

.how-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr auto;
    gap: 5rem;
    align-items: start;
}

.how-left-label {
    font-family: var(--f-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.1;
    position: sticky;
    top: 100px;
}

.how-left-label em {
    display: block;
    font-style: italic;
    color: var(--gold);
}

.steps {
    position: relative;
}

.steps-line {
    position: absolute;
    left: 19px;
    top: 30px;
    bottom: 30px;
    width: 1px;
    background: linear-gradient(to bottom, var(--gold), rgba(201, 168, 76, 0.1));
}

.step {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    margin-bottom: 3rem;
    position: relative;
}

.step:last-child {
    margin-bottom: 0;
}

.step-num-wrap {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--f-display);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--navy);
    box-shadow: 0 0 0 4px var(--cream), 0 0 0 5px var(--gold);
    position: relative;
    z-index: 1;
}

.step-content h3 {
    font-family: var(--f-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.5rem;
}

.step-content p {
    font-size: 14px;
    color: var(--grey);
    line-height: 1.7;
}

.step-content p+p {
    margin-top: 0.4rem;
}

/* Daily email card */
.email-mockup {
    background: var(--white);
    border-radius: 14px;
    border: 1px solid var(--card-border);
    box-shadow: 0 16px 60px rgba(10, 31, 68, 0.09);
    width: 300px;
    flex-shrink: 0;
    overflow: hidden;
    position: sticky;
    top: 100px;
}

.email-bar {
    background: var(--navy);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.email-bar-ico {
    font-size: 16px;
}

.email-bar-title {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
}

.email-body-wrap {
    padding: 16px;
}

.email-subject {
    font-size: 13px;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 4px;
    line-height: 1.4;
}

.email-from {
    font-size: 11px;
    color: var(--grey);
    margin-bottom: 12px;
}

.email-thumb {
    width: 100%;
    height: 90px;
    background: linear-gradient(135deg, #0A1F44, #1a3a7c);
    border-radius: 8px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.email-thumb-inner {
    font-size: 24px;
    opacity: 0.4;
}

.email-thumb-tag {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--gold);
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    color: var(--navy);
    padding: 2px 7px;
}

.email-meta {
    font-size: 11px;
    color: var(--grey);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.email-cta {
    width: 100%;
    background: var(--gold);
    color: var(--navy);
    font-size: 12px;
    font-weight: 700;
    border: none;
    border-radius: 7px;
    padding: 10px;
    cursor: pointer;
    text-align: center;
}

.email-prev-sessions {
    margin-top: 14px;
}

.email-prev-label {
    font-size: 10px;
    color: var(--grey);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
}

.email-prev-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 0;
    border-bottom: 1px solid #F0EAE0;
    font-size: 11px;
    color: var(--navy);
}

.email-prev-row:last-child {
    border-bottom: none;
}

.email-check {
    color: var(--gold);
    font-weight: 700;
}

/*─────────────────────────────────────────
  7. BENTO GRID
─────────────────────────────────────────*/
#bento {
    padding: 8rem 2rem;
    background: var(--white);
    border-top: 1px solid var(--card-border);
}

.bento-inner {
    max-width: 1100px;
    margin: 0 auto;
}

.bento-header {
    text-align: center;
    margin-bottom: 3.5rem;
}

.bento-headline {
    font-family: var(--f-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.2;
    margin-bottom: 0.5rem;
}

.bento-sub {
    font-size: 1rem;
    color: var(--grey);
}

.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto auto;
    gap: 16px;
}

.b-card {
    background: var(--white);
    border-radius: 16px;
    border: 1px solid var(--card-border);
    padding: 2rem;
    transition: box-shadow 0.2s, transform 0.2s;
    overflow: hidden;
    position: relative;
}

.b-card:hover {
    box-shadow: 0 12px 40px rgba(10, 31, 68, 0.09);
    transform: translateY(-2px);
}

.b-card-dark {
    background: var(--navy);
    border-color: transparent;
}

.b-card-cream {
    background: var(--cream);
    border-color: var(--card-border);
}

.b-card-gold {
    background: linear-gradient(135deg, #C9A84C 0%, #E0BF6F 100%);
    border-color: transparent;
}

.b-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.5rem;
}

.b-label-cream {
    color: var(--cream);
    opacity: 0.6;
}

.b-label-navy {
    color: var(--navy);
    opacity: 0.6;
}

.b-card h3 {
    font-family: var(--f-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    margin-bottom: 0.6rem;
}

.b-card-dark h3 {
    color: var(--cream);
}

.b-card-gold h3 {
    color: var(--navy);
}

.b-card p {
    font-size: 13px;
    color: var(--grey);
    line-height: 1.65;
}

.b-card-dark p {
    color: rgba(245, 240, 232, 0.6);
}

.b-card-gold p {
    color: rgba(10, 31, 68, 0.75);
}

/* Span 2 cols */
.b-span2 {
    grid-column: span 2;
}

/* Span 2 rows */
.b-tall {
    grid-row: span 2;
}

/* Card: 90 Sessions */
.sessions-list {
    margin-top: 1rem;
}

.session-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--card-border);
    font-size: 13px;
    color: var(--grey);
}

.session-item:last-child {
    border-bottom: none;
}

.session-item-num {
    font-size: 11px;
    font-weight: 700;
    color: var(--gold);
    min-width: 28px;
}

.session-item-lock {
    font-size: 12px;
    opacity: 0.5;
    margin-left: auto;
}

/* Card: handbook */
.handbook-img {
    width: 100%;
    height: 140px;
    background: linear-gradient(135deg, var(--navy) 0%, #1a3a7c 100%);
    border-radius: 10px;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.handbook-img-inner {
    text-align: center;
}

.handbook-title-mock {
    font-family: var(--f-display);
    font-size: 10px;
    font-weight: 700;
    color: rgba(201, 168, 76, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.4;
}

.handbook-cross {
    width: 24px;
    height: 24px;
    position: relative;
    margin: 8px auto;
    display: flex;
    align-items: center;
    justify-content: center;
}

.handbook-cross::before,
.handbook-cross::after {
    content: '';
    position: absolute;
    background: rgba(201, 168, 76, 0.6);
}

.handbook-cross::before {
    width: 1.5px;
    height: 100%;
}

.handbook-cross::after {
    width: 100%;
    height: 1.5px;
}

/* Card: study anywhere */
.study-icons {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 1rem;
}

.study-row {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--cream);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 13px;
    color: var(--navy);
    font-weight: 500;
}

.study-icon {
    font-size: 18px;
}

/* Card: vision */
.vision-chain {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1.2rem;
    align-items: flex-start;
}

.vision-row {
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
}

.vision-num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(201, 168, 76, 0.15);
    border: 1.5px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    color: var(--gold);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
}

.vision-label {
    font-size: 13px;
    color: var(--cream);
    font-weight: 500;
}

.vision-connector {
    width: 1px;
    height: 20px;
    background: rgba(201, 168, 76, 0.3);
    margin-left: 18px;
}

.vision-final {
    background: var(--gold);
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    color: var(--navy);
    margin-top: 8px;
    margin-left: 0;
}

/* Card: free forever */
.free-price {
    font-family: var(--f-display);
    font-size: 5rem;
    font-weight: 800;
    color: var(--navy);
    line-height: 1;
    margin: 0.8rem 0 0.3rem;
}

.free-sub {
    font-size: 13px;
    color: rgba(10, 31, 68, 0.65);
}

/* Card: daily email */
.inbox-icon {
    width: 60px;
    height: 60px;
    background: rgba(201, 168, 76, 0.12);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    margin-bottom: 1rem;
}

.inbox-stat {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 0.8rem;
}

.inbox-stat-num {
    font-family: var(--f-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--navy);
}

.inbox-stat-label {
    font-size: 13px;
    color: var(--grey);
}

/*─────────────────────────────────────────
  8. COURSE PREVIEW
─────────────────────────────────────────*/
#preview {
    padding: 8rem 0 8rem 2rem;
    background: var(--cream);
    overflow: hidden;
}

.preview-header {
    max-width: 1100px;
    margin: 0 auto 3rem;
    padding-right: 2rem;
}

.preview-headline {
    font-family: var(--f-display);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.5rem;
}

.preview-sub {
    font-size: 1rem;
    color: var(--grey);
}

.preview-scroll-wrap {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 1.5rem;
    padding-right: 2rem;
    scrollbar-width: thin;
    scrollbar-color: var(--card-border) transparent;
}

.preview-scroll-wrap::-webkit-scrollbar {
    height: 4px;
}

.preview-scroll-wrap::-webkit-scrollbar-thumb {
    background: var(--card-border);
    border-radius: 2px;
}

.lesson-card {
    flex-shrink: 0;
    width: 260px;
    background: var(--navy);
    border-radius: 14px;
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s;
}

.lesson-card:hover {
    transform: translateY(-4px);
}

.lesson-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.lesson-num {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--gold);
    margin-bottom: 0.8rem;
    display: block;
}

.lesson-title {
    font-family: var(--f-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--cream);
    line-height: 1.35;
    margin-bottom: 0.7rem;
}

.lesson-desc {
    font-size: 12px;
    color: rgba(245, 240, 232, 0.5);
    line-height: 1.6;
    margin-bottom: 1rem;
}

.lesson-lock {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 11px;
    color: rgba(245, 240, 232, 0.5);
    font-weight: 500;
}

.preview-footer {
    max-width: 1100px;
    margin: 2.5rem auto 0;
    padding-right: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
}

.preview-footer-text {
    font-size: 14px;
    color: var(--grey);
    font-style: italic;
}

.preview-footer-text strong {
    color: var(--navy);
    font-style: normal;
}

/*─────────────────────────────────────────
  9. TESTIMONIALS
─────────────────────────────────────────*/
#testimonials {
    padding: 8rem 2rem;
    background: var(--cream);
    border-top: 1px solid var(--card-border);
}

.testi-inner {
    max-width: 1100px;
    margin: 0 auto;
}

.testi-header {
    text-align: center;
    margin-bottom: 3.5rem;
}

.testi-headline {
    font-family: var(--f-display);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 700;
    color: var(--navy);
}

.testi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
}

.testi-card {
    background: var(--white);
    border-radius: 14px;
    border: 1px solid var(--card-border);
    padding: 1.8rem;
    transition: box-shadow 0.2s;
}

.testi-card:hover {
    box-shadow: 0 10px 36px rgba(10, 31, 68, 0.08);
}

.testi-stars {
    color: var(--gold);
    font-size: 13px;
    margin-bottom: 1rem;
    letter-spacing: 2px;
}

.testi-quote {
    font-family: var(--f-display);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--navy);
    line-height: 1.65;
    margin-bottom: 1.3rem;
}

.testi-quote::before {
    content: '\201C';
}

.testi-quote::after {
    content: '\201D';
}

.testi-author {
    display: flex;
    align-items: center;
    gap: 10px;
}

.testi-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--cream);
    flex-shrink: 0;
}

.testi-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--navy);
}

.testi-role {
    font-size: 11px;
    color: var(--grey);
}

/*─────────────────────────────────────────
  10. HANDBOOK
─────────────────────────────────────────*/
#handbook {
    padding: 7rem 2rem;
    background: var(--white);
    border-top: 1px solid var(--card-border);
    border-bottom: 1px solid var(--card-border);
}

.handbook-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
}

.handbook-visual {
    display: flex;
    justify-content: center;
    align-items: center;
}

.book-mockup {
    width: 280px;
    height: 380px;
    background: linear-gradient(155deg, #F5F0E8 0%, #EDE7D9 100%);
    border-radius: 4px 16px 16px 4px;
    border: 1px solid var(--card-border);
    box-shadow: -6px 6px 0 0 var(--card-border), 16px 24px 60px rgba(10, 31, 68, 0.15);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
}

.book-mockup::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
