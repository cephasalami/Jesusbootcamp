  12. FINAL CTA
─────────────────────────────────────────*/
#cta-final {
    background: var(--navy);
    padding: 8rem 2rem;
    border-top: 1px solid rgba(201, 168, 76, 0.2);
    text-align: center;
    position: relative;
    overflow: hidden;
}

#cta-final::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
        radial-gradient(ellipse 60% 50% at 50% 0%, rgba(201, 168, 76, 0.1) 0%, transparent 70%),
        radial-gradient(ellipse 40% 40% at 80% 100%, rgba(201, 168, 76, 0.06) 0%, transparent 70%);
}

.cta-inner {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
}

.cta-headline {
    font-family: var(--f-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    color: var(--cream);
    line-height: 1.1;
    margin-bottom: 1rem;
}

.cta-sub {
    font-size: 1.05rem;
    color: var(--gold);
    font-weight: 500;
    margin-bottom: 2.5rem;
    line-height: 1.5;
}

.cta-form {
    display: flex;
    gap: 0;
    max-width: 540px;
    margin: 0 auto 1rem;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.3);
}

.cta-input {
    flex: 1;
    padding: 1rem 1.4rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    border-right: none;
    color: var(--cream);
    font-family: var(--f-body);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
    border-radius: 10px 0 0 10px;
}

.cta-input::placeholder {
    color: rgba(245, 240, 232, 0.35);
}

.cta-input:focus {
    border-color: rgba(201, 168, 76, 0.6);
}

.cta-submit {
    background: var(--gold);
    border: none;
    color: var(--navy);
    font-family: var(--f-body);
    font-size: 14px;
    font-weight: 700;
    padding: 1rem 1.6rem;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
    border-radius: 0 10px 10px 0;
}

.cta-submit:hover {
    background: var(--gold2);
}

.cta-fine {
    font-size: 12px;
    color: rgba(245, 240, 232, 0.35);
