}

.book-inner-top {
    text-align: center;
}

.book-subtitle {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 1rem;
}

.book-cross {
    width: 50px;
    height: 50px;
    position: relative;
    margin: 0 auto 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.book-cross::before,
.book-cross::after {
    content: '';
    position: absolute;
    background: var(--navy);
}

.book-cross::before {
    width: 2px;
    height: 100%;
}

.book-cross::after {
    width: 100%;
    height: 2px;
}

.book-title {
    font-family: var(--f-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--navy);
    text-align: center;
    line-height: 1.3;
    margin-bottom: 0.3rem;
}

.book-subtitle2 {
    font-size: 9px;
    color: var(--grey);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.1em;
}

.book-author {
    font-size: 11px;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 0.06em;
    text-align: center;
}

.handbook-text .section-tag {
    margin-bottom: 1.2rem;
}

.handbook-text h2 {
    font-family: var(--f-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    margin-bottom: 1rem;
}

.handbook-text p {
    font-size: 1rem;
    color: var(--grey);
    line-height: 1.8;
    margin-bottom: 2rem;
}

.handbook-pills {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
}

.handbook-pill {
    background: var(--cream);
    border: 1px solid var(--card-border);
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
    color: var(--navy);
    display: flex;
    align-items: center;
    gap: 6px;
}

/*─────────────────────────────────────────
  11. ABOUT / CREDIBILITY
─────────────────────────────────────────*/
#about {
    background: var(--navy);
    padding: 7rem 2rem;
}

.about-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 6rem;
    align-items: center;
}

.about-portrait {
    text-align: center;
}

.portrait-frame {
    width: 220px;
    height: 260px;
    margin: 0 auto;
    background: linear-gradient(135deg, #1a3a7c 0%, #0A1F44 100%);
    border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
    border: 3px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 0 0 6px rgba(201, 168, 76, 0.15);
    position: relative;
    overflow: hidden;
}

.portrait-placeholder {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.3);
    text-align: center;
    padding: 1rem;
    line-height: 1.6;
}

.portrait-name {
    font-family: var(--f-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--cream);
    margin-bottom: 0.3rem;
}

.portrait-role {
    font-size: 12px;
    color: var(--gold);
    font-weight: 500;
}

.about-content .section-tag {
    margin-bottom: 1.2rem;
    border-color: rgba(201, 168, 76, 0.3);
}

.about-content p {
    font-size: 1.05rem;
    color: rgba(245, 240, 232, 0.75);
    line-height: 1.85;
    margin-bottom: 2rem;
}

.about-badges {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
}

.cred-badge {
